# opera-tms-ws — per-host environment template
#
# Initial setup:
#   cp .env.example .env
#   sed -i "s/^UID=.*/UID=$(id -u)/; s/^GID=.*/GID=$(id -g)/" .env
#
# `.env` is gitignored. Edit it per host. Docker Compose reads it automatically
# during build / up, so you do NOT need to pass UID=$(id -u) inline anymore.

# --- REQUIRED ---
# host UID/GID to align with the in-container `ros` user, so bind-mounted
# files (src/, build/, install/, log/) are writable from both sides.
# Forgetting these defaults to 1000:1000 and silently corrupts permissions
# when your host uid is anything else.
UID=1000
GID=1000

# --- OPTIONAL ---
# X11 forward. Usually inherited from the launching shell; set here if your
# host changes DISPLAY per session (e.g. xrdp) and you want a stable value.
# DISPLAY=:0

# ROS 2 domain id (0-101). Default 0. Change only if sharing the host with
# other ROS 2 users on the same domain.
# ROS_DOMAIN_ID=0

# RMW backend. Default rmw_cyclonedds_cpp (set in compose.yaml). Switch to
# rmw_fastrtps_cpp if you specifically need Fast DDS behaviour.
# RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
