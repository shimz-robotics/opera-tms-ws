# vcs import populates src/ on the host. Each entry is its own git repo and
# is tracked by src.repos / src.private.repos, not by this meta-repo.
src/

# docker compose down -v cleans named volumes, but local override files can
# accumulate. Keep them out of git.
compose.override.yaml
.env
.env.local

# Cyclone DDS profile for Node-RED 並列運用 (private repo 由来や個別調整あり)
cyclonedds.conf

# Editor / OS noise
.vscode/
.idea/
.DS_Store
